<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moussadjal_mobile_app.Pages.Locaux"
              Title="Consulter les locaux">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="20">

        <Label Grid.Row="0"
               Text="Locaux disponibles"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,20"/>

        <SearchBar Grid.Row="1"
                   x:Name="LocationSearchBar"
                   Placeholder="Rechercher un local..."
                   TextChanged="SearchTextChanged"
                   Margin="0,0,0,10"/>

        <CollectionView Grid.Row="2"
                        x:Name="LocationsCollection"
                        SelectionMode="Single"
                        SelectionChanged="LocationSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5,0,5"
                           Padding="15"
                           BorderColor="LightGray"
                           CornerRadius="8"
                           HasShadow="True">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto">

                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{Binding Description}"
                                   TextColor="#708090"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"/>

                            <Label Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Grid.Column="1"
                                   Text="{Binding ItemCount, StringFormat='{0} biens'}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End"
                                   TextColor="#00B4D8"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="20">
                    <Image Source="empty_locations.png"
                           HeightRequest="100"
                           WidthRequest="100"
                           Opacity="0.5"/>
                    <Label Text="Aucun local trouvé"
                           FontSize="18"
                           TextColor="#708090"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>