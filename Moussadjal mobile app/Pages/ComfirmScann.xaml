<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moussadjal_mobile_app.Pages.ComfirmScann"
              Title="Confirmer le scanne">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="20">

        <Label Grid.Row="0"
               Text="Confirmer le scan"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,20"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">
                <Frame BorderColor="LightGray"
                       CornerRadius="8"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Informations du bien"
                               FontSize="18"
                               FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="15"
                              ColumnSpacing="10">

                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="ID:"
                                   FontAttributes="Bold"/>
                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   x:Name="ItemIdLabel"
                                   Text="[ID du bien]"/>

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Nom:"
                                   FontAttributes="Bold"/>
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   x:Name="ItemNameLabel"
                                   Text="[Nom du bien]"/>

                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Catégorie:"
                                   FontAttributes="Bold"/>
                            <Label Grid.Row="2"
                                   Grid.Column="1"
                                   x:Name="ItemCategoryLabel"
                                   Text="[Catégorie]"/>

                            <Label Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Local:"
                                   FontAttributes="Bold"/>
                            <Label Grid.Row="3"
                                   Grid.Column="1"
                                   x:Name="ItemLocationLabel"
                                   Text="[Local]"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Frame BorderColor="LightGray"
                       CornerRadius="8"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Mettre à jour l'emplacement"
                               FontSize="18"
                               FontAttributes="Bold"/>

                        <Picker x:Name="LocationPicker"
                                Title="Sélectionner un local"
                                Margin="0,10,0,0"/>

                        <Label Text="Notes:"
                               FontAttributes="Bold"
                               Margin="0,10,0,0"/>
                        <Editor x:Name="NotesEditor"
                                Placeholder="Ajouter des notes (optionnel)"
                                HeightRequest="100"
                                AutoSize="TextChanges"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame BorderColor="LightGray"
                       CornerRadius="8"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="État du bien"
                               FontSize="18"
                               FontAttributes="Bold"/>

                        <RadioButton x:Name="GoodConditionRadio"
                                     Content="Bon état"
                                     GroupName="Condition"
                                     IsChecked="True"/>

                        <RadioButton x:Name="FairConditionRadio"
                                     Content="État moyen"
                                     GroupName="Condition"/>

                        <RadioButton x:Name="PoorConditionRadio"
                                     Content="Mauvais état"
                                     GroupName="Condition"/>

                        <RadioButton x:Name="DamagedConditionRadio"
                                     Content="Endommagé"
                                     GroupName="Condition"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="2"
                               HorizontalOptions="Center"
                               Spacing="15"
                               Margin="0,20,0,0">
            <Button Text="Confirmer"
                    Clicked="OnConfirmClicked"
                    BackgroundColor="#7DB828"
                    TextColor="White"
                    CornerRadius="8"
                    WidthRequest="120"/>

            <Button Text="Annuler"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Transparent"
                    TextColor="#708090"
                    BorderColor="#708090"
                    BorderWidth="1"
                    CornerRadius="8"
                    WidthRequest="120"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>