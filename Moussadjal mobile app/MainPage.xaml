<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="Moussadjal_mobile_app.MainPage">
    <Grid RowDefinitions="Auto,*,Auto"
          Padding="20">

        <Label Grid.Row="0"
               Text="Ajouter un nouveau bien"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,20"/>
        <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="20">
                    <Frame BorderColor="LightGray"
                      CornerRadius="8"
                      Padding="15"
                      HasShadow="True">
                        <VerticalStackLayout Spacing="15">
                            <Label Text="Informations du produit"
                                    FontSize="18"
                                  FontAttributes="Bold"/>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Numéro d'inventaire *"
                                       FontAttributes="Bold"/>
                                <Entry x:Name="InventoryEntry"
                                      Placeholder="Numéro d'inventaire"
                                       PlaceholderColor="#708090"
                                      ClearButtonVisibility="WhileEditing"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Numéro séquentiel *"
                                       FontAttributes="Bold"/>
                                <Entry x:Name="SequentialEntry"
                                       Placeholder="Numéro séquentiel"
                                       PlaceholderColor="#708090"
                                       ClearButtonVisibility="WhileEditing"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Lieu d'utilisation *"
                                        FontAttributes="Bold"/>
                                <Entry x:Name="PlaceEntry"
                                       Placeholder="Lieu d'utilisation"
                                          PlaceholderColor="#708090"
                                       ClearButtonVisibility="WhileEditing"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                    <Frame BorderColor="LightGray"
                           CornerRadius="8"
                           Padding="15"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="15">
                            <Label Text="Code DataMatrix"
                                     FontSize="18"
                                   FontAttributes="Bold"/>

                            <zxing:BarcodeGeneratorView x:Name="bgv"
                                        Format="DataMatrix"
                                  WidthRequest="200"
                                 HeightRequest="200" 
                               VerticalOptions="Center"
                             HorizontalOptions="Center" />

                        <Image x:Name="BarcodeImage"
                               HeightRequest="200"
                               WidthRequest="200"
                               HorizontalOptions="Center"
                               IsVisible="false"/>

                        <Label x:Name="ResultLabel"
                              HorizontalOptions="Center"
                                TextColor="#00B4D8"
                                FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="2"
                              HorizontalOptions="Center"
                               Spacing="15"
                                 Margin="0,20,0,0">
            <Button x:Name="GenerateButton" 
                      Text="add product"
                      BackgroundColor="#7DB828"
                      TextColor="White"
                      CornerRadius="8"
                      WidthRequest="150"
                      SemanticProperties.Hint="Generates barcode for the product"
                      Clicked="GenerateButton_Clicked"/>

                <Button  x:Name="GoToScann"
                       Text="scannCode"
                      BackgroundColor="#00B4D8"
                        TextColor="White"
                       CornerRadius="8"
                       WidthRequest="150"
                       Clicked="GoToScann_Clicked"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
